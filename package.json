{
  "name": "openclaw-ui",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "start": "node start.js",
    "build": "vite build",
    "deploy": "vite build && launchctl unload ~/Library/LaunchAgents/com.openclaw.ui.server.plist 2>/dev/null; launchctl load ~/Library/LaunchAgents/com.openclaw.ui.server.plist"
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@vitejs/plugin-react": "^4.5.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.1.8",
    "vite": "^6.3.5"
  }
}
